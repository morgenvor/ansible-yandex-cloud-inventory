include README.md
include README.ru.md
include LICENSE
recursive-include inventory_plugins *.py
recursive-include examples *.yml
recursive-include docs *.md
# Стенд кладём в sdist: по собранному архиву можно проверить плагин без облака.
recursive-include tests *.py *.sh *.yml *.json
# Без этих файлов стенд из распакованного sdist не запускается: run-tests.sh
# читает ansible.cfg, а .venv собирает bootstrap.sh по requirements-test.txt.
include ansible.cfg
include bootstrap.sh
include requirements-test.txt
